# Environment variables for Django project
DEBUG=True
SECRET_KEY=your-secret-key-here-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Supabase Database Configuration
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your-supabase-db-password
DATABASE_HOST=your-supabase-host.supabase.co
DATABASE_PORT=5432

# Supabase API Configuration (if needed for direct API calls)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Email Settings (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=your-email@example.com

# OMDB API (deprecated - now using Supabase Movies table)
# OMDB_API_KEY=your-omdb-api-key-here
# OMDB_BASE_URL=http://www.omdbapi.com/

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
